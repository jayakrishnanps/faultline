{
  "name": "faultline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.16.0 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.13.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "npm run test:unit && npm run test:database",
    "test:unit": "vitest run",
    "test:database": "node --test tests/database/*.test.ts",
    "fixtures:load": "node scripts/fixtures/load-demo-store.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run db:types:check && npm run build",
    "db:types": "node scripts/db/generate-types.ts",
    "db:types:check": "node scripts/db/generate-types.ts --check",
    "db:check": "node --env-file=.env.local scripts/db/check-remote.ts",
    "db:setup": "npm run db:types:check && node --env-file=.env.local scripts/db/setup-remote.ts",
    "db:verify": "node --env-file=.env.local scripts/db/setup-remote.ts --verify"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "@typescript-eslint/typescript-estree": "8.70.1",
    "@typescript-eslint/visitor-keys": "8.70.1",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "typescript": "5.9.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "postgres": "3.4.9",
    "vitest": "5.0.2"
  }
}

# No credentials are needed for analyzer development, local tests or the sample build.
# Optional Supabase project origin; read only when an integration client is created.
NEXT_PUBLIC_SUPABASE_URL=
# Optional public browser key for Supabase reads; never use an administrative key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional administrative key. Server only; requires authorization before client use.
SUPABASE_SECRET_KEY=
# Optional direct/session-pooler connection for explicitly authorized hosted DB tooling.
# Local tests and CI do not use this. URL-encode a password when configuring locally.
DATABASE_URL=
